{
  "name": "blackglass",
  "version": "0.4.1",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": "1.3.8"
  },
  "type": "module",
  "imports": {
    "#release-playwright-core": "playwright-core",
    "#release-typescript": "typescript"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "analyze:release": "bun run tools/analyze-release.ts",
    "bridge": "bun run tools/bridge-cli.ts",
    "build:standalone": "bash scripts/build-standalone-bridge.sh",
    "verify:standalone": "bun run tools/verify-standalone-bridge.ts",
    "verify:standalone:reproducibility": "bun run tools/verify-standalone-reproducibility.ts",
    "compatibility:check": "bun run tools/compatibility-matrix.ts --check",
    "compatibility:write": "bun run tools/compatibility-matrix.ts --write",
    "compatibility:add": "bun run tools/write-compatibility-matrix-entry.ts",
    "baseline:candidate": "bun run tools/create-baseline-candidate.ts",
    "release:candidate:create": "bun run tools/create-release-candidate.ts",
    "release:doctor": "bun run tools/doctor-release-candidate.ts",
    "release:run": "bun run tools/run-release-candidate.ts",
    "patch:client": "bun run tools/patch-client.ts",
    "package:macos": "bun run tools/package-macos.ts",
    "package:macos:verify-reproducibility": "bun run tools/verify-macos-reproducibility.ts",
    "client:launch": "bun run tools/launch-macos.ts",
    "client:inspect": "bun run tools/inspect-macos-app.ts",
    "e2e:prepare": "bun run tools/prepare-e2e.ts",
    "e2e:smoke:macos": "bun run tools/smoke-macos-launch.ts",
    "e2e:observe": "bun run tools/observe-e2e.ts",
    "e2e:network:capture": "bun run tools/capture-e2e-network.ts",
    "e2e:network:finalize": "bun run tools/finalize-e2e-network.ts",
    "e2e:qualify": "bun run tools/qualify-e2e.ts",
    "e2e:reset-for-recovery": "bun run tools/reset-e2e-for-recovery.ts",
    "e2e:reset-client": "bun run tools/reset-e2e-client.ts",
    "e2e:server": "bun run tools/run-e2e-server.ts",
    "e2e:verify": "bun run tools/verify-e2e.ts",
    "e2e:scenario:capture": "bun run tools/capture-e2e-scenario-checkpoint.ts",
    "e2e:release:capture": "bun run tools/capture-release-e2e-checkpoint.ts",
    "e2e:scenario:verify": "bun run tools/verify-e2e-scenario.ts",
    "e2e:tls:prepare": "bun run tools/prepare-e2e-tls.ts",
    "e2e:tls:proxy": "bun run tools/run-e2e-tls-proxy.ts",
    "e2e:validation:write": "bun run tools/write-validation-record.ts",
    "release:verify-eligibility": "bun run tools/verify-release-eligibility.ts",
    "tooling:verify-qualified": "bun run tools/verify-qualified-tooling.ts",
    "recovery:drill": "bun run tools/recovery-drill.ts",
    "runtime:verify": "bun run tools/verify-runtime.ts",
    "check:distribution": "bun run tools/distribution-boundary.ts",
    "check:fast": "bun run runtime:verify && bun run check:distribution && bun run compatibility:check && bun run typecheck && bun test tests/cli-flags.test.ts tests/client-adapter.test.ts tests/client-contract.test.ts tests/release-candidate.test.ts tests/release-compatibility.test.ts tests/release-runner.test.ts tests/tooling-source.test.ts",
    "check:full": "bun run runtime:verify && bun run check:distribution && bun run compatibility:check && bun run typecheck && bun test",
    "check": "bun run check:full",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "playwright-core": "^1.62.0",
    "typescript": "^5.9.2"
  }
}
