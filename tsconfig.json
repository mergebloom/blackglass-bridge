{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ]
}
